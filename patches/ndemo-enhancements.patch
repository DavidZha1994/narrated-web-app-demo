+/**
+ * Cinematic zoom: ease the whole page toward an element. Uses a CSS transform
+ * on <html>, which composes on top of the browser-level zoom (the zoom
+ * extension uses chrome.tabs.setZoom, not a transform, so they don't fight).
+ * transform-origin is the element's document-space center, so the element
+ * stays anchored while everything scales around it.
+ */
+async function zoomTo(page: Page, locator: Locator, scale: number): Promise<void> {
+  const pos = await getElementPosition(locator);
+  if (!pos) return;
+  await page.evaluate(({ cx, cy, scale }: { cx: number; cy: number; scale: number }) => {
+    const el = document.documentElement;
+    el.style.transformOrigin = `${cx + window.scrollX}px ${cy + window.scrollY}px`;
+    el.style.transition = "transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)";
+    el.style.transform = `scale(${scale})`;
+  }, { cx: pos.cx, cy: pos.cy, scale });
+  await page.waitForTimeout(700);
+}
+
+/** Ease the page back to its natural scale (scene change). */
+async function zoomReset(page: Page): Promise<void> {
+  const had = await page.evaluate(() => {
+    const el = document.documentElement;
+    if (!el.style.transform) return false;
+    el.style.transition = "transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)";
+    el.style.transform = "";
+    return true;
+  }).catch(() => false);
+  if (had) await page.waitForTimeout(500);
+}
+
+export { injectCursor, pointAt, clickEffect, hideCursor, zoomTo, zoomReset };
