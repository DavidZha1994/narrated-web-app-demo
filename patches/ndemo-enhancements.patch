+// Non-fatal readiness wait. A `done` condition that times out or errors must
+// NOT crash the whole render — log and continue. This makes smart waits
+// (done: { stable }, { networkIdle }) safe to use instead of guessed fixed
+// waits: the segment proceeds as soon as the page settles, and a slow/odd
+// response just falls through instead of aborting the render.
+async function awaitDone(page: Page, done: NonNullable<Action["done"]>): Promise<void> {
+  try {
+    await waitForDone(page, done);
+  } catch (err) {
+    console.error(`  (done not met, continuing: ${String(err).split("\n")[0]})`);
+  }
+}
