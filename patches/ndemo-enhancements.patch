  +/**
  + * Capture cookies + localStorage from the live daemon session into a
  + * storageState JSON file, so a later headless render can restore the
  + * login even though `close` SIGKILLs Chromium (which loses unflushed
  + * localStorage, e.g. the OpenWebUI auth token).
  + */
  +async function captureAuth(outPath = path.join(INFO_DIR, "auth.json")): Promise<void> {
  +  const { page } = await connect();
  +  const state = await page.context().storageState();
  +
  +  // storageState() over a CDP connection often misses localStorage, where
  +  // OpenWebUI keeps its auth token. Read it directly from the page and merge
  +  // it into the storageState origins so the render can restore the session.
  +  const origin = new URL(page.url()).origin;
  +  const ls = await page.evaluate(() => {
  +    const out: Record<string, string> = {};
  +    for (let i = 0; i < localStorage.length; i++) {
  +      const k = localStorage.key(i);
  +      if (k) out[k] = localStorage.getItem(k) ?? "";
  +    }
  +    return out;
  +  });
  +  const lsItems = Object.entries(ls).map(([name, value]) => ({ name, value }));
  +  if (lsItems.length) {
  +    const existing = (state.origins ?? []).find(o => o.origin === origin);
  +    if (existing) existing.localStorage = lsItems;
  +    else (state.origins ??= []).push({ origin, localStorage: lsItems });
  +  }
  +
  +  fs.mkdirSync(path.dirname(outPath), { recursive: true });
  +  fs.writeFileSync(outPath, JSON.stringify(state, null, 2));
  +  const originCount = state.origins?.length ?? 0;
  +  const lsCount = state.origins?.reduce((n, o) => n + (o.localStorage?.length ?? 0), 0) ?? 0;
  +  console.log(`Auth captured to ${outPath} (${state.cookies.length} cookies, ${originCount} origins, ${lsCount} localStorage items)`);
  +}
